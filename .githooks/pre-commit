#!/bin/sh
# Verificările de versionare (D009). Activare, o dată pe clonă:
#   git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACMRD)

# 1. Orice schimbare de cod crește versiunea aplicației și are intrare în istoric.
cod=$(printf '%s\n' "$staged" \
	| grep -E '\.(go|sql|ts|tsx|js|jsx|css|json)$|^go\.(mod|sum)$' \
	| grep -vE '^docs/|^internal/versiune/versiune\.go$')
if [ -n "$cod" ]; then
	if ! git diff --cached -- internal/versiune/versiune.go | grep -q '^+const Aplicatie'; then
		echo "D009: commit-ul schimbă codul, dar nu crește versiunea din internal/versiune/versiune.go:" >&2
		printf '  %s\n' $cod >&2
		exit 1
	fi
	if ! printf '%s\n' "$staged" | grep -qx 'docs/versiuni.md'; then
		echo "D009: versiunea nouă trebuie descrisă în docs/versiuni.md" >&2
		exit 1
	fi
fi

# 2. O migrare salvată nu se mai modifică; orice schimbare a bazei e o migrare nouă.
# „Salvată” = există în main (D010). Pe o ramură încă neadusă în main, o migrare
# se poate redenumi, de exemplu când altă ramură a folosit deja același număr.
modificate=""
for f in $(git diff --cached --name-only --no-renames --diff-filter=MD -- internal/bd/migrari/); do
	if git cat-file -e "main:$f" 2>/dev/null; then
		modificate="$modificate $f"
	fi
done
if [ -n "$modificate" ]; then
	echo "D009: migrările existente nu se modifică; scrie o migrare nouă:" >&2
	printf '  %s\n' $modificate >&2
	exit 1
fi

# 3. Fișierele Go din commit sunt formatate cu gofmt (AGENTS.md §5, F02-T14).
go_staged=$(printf '%s\n' "$staged" | grep -E '\.go$' || true)
if [ -n "$go_staged" ]; then
	if ! command -v gofmt >/dev/null 2>&1; then
		echo "gofmt nu este în PATH; nu pot verifica formatarea fișierelor Go." >&2
		exit 1
	fi
	neformatate=""
	for f in $go_staged; do
		[ -f "$f" ] || continue
		# Se verifică versiunea din index, nu cea din directorul de lucru.
		if [ -n "$(git show ":$f" | gofmt -l)" ]; then
			neformatate="$neformatate $f"
		fi
	done
	if [ -n "$neformatate" ]; then
		echo "Fișiere Go neformatate; rulează gofmt -w:" >&2
		printf '  %s\n' $neformatate >&2
		exit 1
	fi
fi

exit 0
