# Date reale ale angajaților (GDPR) — nu intră niciodată în repo
date-reale/

# Folderul de date operaționale al aplicației (D002), dacă e creat la rularea din repo
karios/

# Baze de date locale
*.db
*.db-wal
*.db-shm

# Secrete și configurări locale
.env
*.local.toml

# Build
build/bin/
frontend/node_modules/
frontend/dist/*
!frontend/dist/gitkeep

# Medii locale
.venv/

# Cache Wails
frontend/package.json.md5

# Cache AI local pentru pachete portabile
.cache-ai/
*.gguf
llama-server.exe
tools/

# Cache Python generat de verificarile livrarii.
__pycache__/
